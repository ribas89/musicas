# Musica — fresh install, native Navidrome + Authentik OIDC
# Copy to ../.env when using the bundled Docker Compose example.
# Register OIDC_REDIRECT_URL as an exact redirect URI in Authentik.

# Authentik provider (authorization code, PKCE, RS256)
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=https://music.example.com/auth/oidc/callback

# Required bootstrap account, separate from Authentik identities
ADMIN_USER=admin
ADMIN_PASSWORD=

# Public/shared music; regular album folders are NOT playlists
ND_MUSICFOLDER=/music/public

# Each authenticated user gets /music/users/<username> as a private library
MUSIC_USERS_ROOT=/music/users

# Native lyrics lookup and scheduled scan (Go duration syntax; 0 disables scheduling)
LYRICS_URL=https://lrclib.net
LYRICS_INTERVAL=24h

# Must match the Traefik backend port in docker-compose
ND_PORT=4553

# We create native smart playlists, NOT .nsp/.m3u imports
ND_AUTOIMPORTPLAYLISTS=false

# MusicasYT worker — browser never receives the API key.
# This origin is served over HTTPS by Traefik (worker itself speaks plain HTTP).
MUSICASYT_URL=https://youtube-worker.example.com
# Use the same secret in the YouTube worker configuration; do not commit a real key.
MUSICASYT_API_KEY=

# Docker Compose settings (read with --env-file ../.env).
# Set MUSICAS_HOST to the public hostname used in OIDC_REDIRECT_URL.
MUSICAS_HOST=music.example.com
# The name of an existing external network shared by Traefik and Musicas.
TRAEFIK_NETWORK=traefik
# Host directory containing build/, data/, music/, and .env (relative to build/).
MUSICAS_ROOT=..
